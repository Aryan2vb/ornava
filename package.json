{
  "name": "ornava",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm --filter @ornava/web dev",
    "dev:web": "pnpm --filter @ornava/web dev",
    "dev:worker": "pnpm --filter @ornava/worker dev",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/check-db.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @ornava/shared build && pnpm --filter @ornava/web test && pnpm --filter @ornava/worker test"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "pnpm": {}
}
