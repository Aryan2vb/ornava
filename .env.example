# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Auth - Supabase Auth (email + password, optional Google).
# Project URL and publishable key from Supabase -> Settings -> API keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ADMIN_EMAILS=

# Database - Supabase Postgres (transaction pooler, port 6543), or the local
# Docker Postgres from docker-compose.yml (postgresql://postgres:postgres@localhost:55432/ornava).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/ornava

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ORIGINALS_BUCKET=ornava-originals
R2_GENERATED_BUCKET=ornava-generated
R2_THUMBNAILS_BUCKET=ornava-thumbnails

# Queue
REDIS_URL=redis://localhost:6379

# AI model routing
IMAGE_MODEL_DEFAULT=ornava-default-v1
IMAGE_MODEL_STUDIO=
IMAGE_MODEL_ON_MODEL=
IMAGE_MODEL_CLOSE_UP=
FAL_KEY=
# Webhook support for async Fal.ai completion.
# Fal signs webhooks with their own ED25519 keys — no shared secret from us
# is needed. Verification uses public keys from:
#   https://rest.fal.ai/.well-known/jwks.json
#
# WEBHOOK_BASE_URL: public URL where Fal can reach us. Required for async mode.
# Production: https://your-domain.com
# Local: use ngrok → https://xxx.ngrok-free.dev
WEBHOOK_BASE_URL=

# Observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
